{
  "name": "@mememio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file=../.env src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@hono/node-server": "^1.13.8",
    "@modelcontextprotocol/server": "^2.3.1",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.16",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "sharp": "^0.35.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
